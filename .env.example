# Supabase Configuration
# Copiez ce fichier en .env et remplissez avec vos valeurs

# URL de votre projet Supabase
SUPABASE_URL=http://localhost:54321

# Clé API (anon key) - pour les opérations non authentifiées
SUPABASE_ANON_KEY=your-anon-key-here

# Clé service role - pour les opérations admin (à garder secrète !)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL du frontend
FRONTEND_URL=http://localhost:3000

# Mode de l'application (development/production)
NODE_ENV=development
